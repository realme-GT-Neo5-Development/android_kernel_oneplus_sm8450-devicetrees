include $(srctree)/$(src)/../../oplus/dtb-selection.mk

dtbo-$(CONFIG_ARCH_CAPE) += $(if $(oplus-dtb-cape),cape-eva.dtbo)
dtbo-$(CONFIG_ARCH_CAPE) += $(if $(oplus-dtb-ukee),ukee-eva.dtbo)
dtbo-$(CONFIG_ARCH_WAIPIO) += $(if $(oplus-dtb-waipio),waipio-eva.dtbo)

dtbo-y := $(strip $(call oplus-dtb-uniq,$(dtbo-y)))
